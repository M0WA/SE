# Copy this file to .env (git-ignored) before running `docker compose up`.
# docker compose auto-loads a .env file next to docker-compose.yml -- see
# packaging/docker/README.md for the full walkthrough.

# Required -- docker compose refuses to start without these two set to a
# real value (see the ":?" defaults in docker-compose.yml itself).
SETTINGS_ENCRYPTION_KEY=
CRAWL_INTERNAL_TOKEN=
# Generate each with:
#   openssl rand -hex 32

# Optional -- both default to blank/disabled if left unset, same as a
# plain .deb install (see docs/manual/environment-variables.md).
SEARCH_INTERNAL_API_KEY=
CHAT_VISION_INTERNAL_API_KEY=

# Optional -- override which image tag to run (defaults to the latest
# published release). Point this at a locally built tag (e.g.
# searchengine:test) to test an unreleased change.
#SEARCHENGINE_IMAGE=ghcr.io/m0wa/se:latest

# Optional -- override the host ports each service binds to, useful if
# 8080/8081/5432 are already taken on this machine.
#SEARCH_HOST_PORT=8080
#ADMIN_HOST_PORT=8081
#POSTGRES_HOST_PORT=5432
