flowchart LR
  subgraph External["External systems"]
    Browser["Public users / browsers"]
    Nginx["nginx (80/443)"]
    subgraph GPUBox["gpu.mo-sys.de (H200 NVL, vLLM)"]
      EmbedAPI["vLLM: Qwen3-VL-Embedding-8B<br/>pooling/embed mode, :8000"]
      ChatAPI["vLLM: Qwen2.5-72B-Instruct-FP8<br/>chat/generate mode, :8001"]
      ComfyUI["ComfyUI + LTX-2.5<br/>image/video generation, :8188<br/>(Vision mode only, mutually<br/>exclusive with ChatAPI)"]
      GPUControl["cmd/gpu-control<br/>root, private LAN, :8002"]
    end
    SearXNG["SearXNG metasearch<br/>127.0.0.1:8888"]
    Sites["Crawled websites"]
    S3["S3(-compatible) bucket<br/>admin-chosen per import"]
    IONOSMon["IONOS Monitoring Service"]
    Docker["Docker daemon<br/>(local, opt-in via docker group)"]
  end

  subgraph Binaries["Binaries"]
    Search["cmd/search<br/>public, 127.0.0.1:8080"]
    Admin["cmd/admin<br/>internal, 127.0.0.1:8081"]
    Crawl["cmd/crawl<br/>internal only, 127.0.0.1:8082"]
    MCPWeb["cmd/mcp-web<br/>spawned stdio subprocess<br/>(not a service)"]
    MCPDatetime["cmd/mcp-datetime<br/>spawned stdio subprocess<br/>(not a service)"]
    MCPSandbox["cmd/mcp-sandbox<br/>spawned stdio subprocess<br/>(not a service)"]
    MCPFiles["cmd/mcp-files<br/>spawned stdio subprocess<br/>(not a service)"]
    MCPVision["cmd/mcp-vision<br/>spawned stdio subprocess<br/>(not a service)"]
  end

  subgraph Core["Core: domain + ports + application"]
    Domain["internal/domain<br/>BM25, hybrid ranking, PageRank,<br/>tokenizer, fuzzy match, settings"]
    Ports["internal/ports<br/>33 interfaces"]
    App["internal/application<br/>hybridSearchService, crawlLoop,<br/>*Job, ChatService, scheduler"]
  end

  subgraph Adapters["Adapters (internal/adapters/*)"]
    RestAPI["restapi<br/>HTTP handlers for cmd/search + cmd/admin"]
    SQLRepo["sqlrepo<br/>SQL persistence"]
    HTTPFetcher["httpfetcher"]
    BrowserFetcher["browserfetcher<br/>Chromium/Firefox via Playwright"]
    HTMLParser["htmlparser"]
    Robots["robots"]
    Netguard["netguard<br/>SSRF guard<br/>(crawler + configured-endpoint policies)"]
    HashEmbed["hashembed"]
    HTTPEmbed["httpembed"]
    HTTPChat["httpchat"]
    CrawlClient["crawlclient"]
    SettingsCrypto["settingscrypto"]
    MCPClient["mcpclient<br/>MCP client (stdio/http)"]
    DockerSandbox["dockersandbox<br/>locked-down Docker containers"]
  end

  DB[("Shared SQL database<br/>SQLite local/CI, Postgres dev")]

  Browser --> Nginx
  Nginx -->|"/, /search, static"| Search
  Nginx -->|"/admin, /login, /logout"| Admin

  Search --> RestAPI
  Admin --> RestAPI
  Crawl --> RestAPI

  RestAPI --> App
  App --> Ports
  Ports --> Domain

  Admin -->|"crawlclient over HTTP<br/>X-Internal-Token"| Crawl

  App --> SQLRepo
  RestAPI --> SettingsCrypto
  RestAPI --> Netguard
  Admin --> CrawlClient
  SQLRepo --> DB

  Crawl --> HTTPFetcher
  Crawl --> BrowserFetcher
  Crawl --> HTMLParser
  Crawl --> Robots
  HTTPFetcher --> Netguard
  BrowserFetcher --> Netguard
  HTTPFetcher --> Sites
  BrowserFetcher --> Sites
  Robots --> Sites

  App --> HashEmbed
  App --> HTTPEmbed
  App --> HTTPChat
  HTTPEmbed --> Netguard
  HTTPChat --> Netguard
  HTTPEmbed --> EmbedAPI
  HTTPChat --> ChatAPI
  App --> MCPClient
  MCPClient -.->|"spawns as child process"| MCPWeb
  MCPClient -.->|"spawns as child process"| MCPDatetime
  MCPClient -.->|"spawns as child process"| MCPSandbox
  MCPClient -.->|"spawns as child process"| MCPFiles
  MCPClient -.->|"spawns as child process"| MCPVision
  MCPWeb -->|"web_search tool"| SearXNG
  MCPSandbox --> DockerSandbox
  DockerSandbox -.->|"docker CLI"| Docker
  MCPSandbox -->|"HTTP, per-turn bearer token<br/>/account/api/files (file_ids)"| Search
  MCPFiles -->|"HTTP, per-turn bearer token<br/>/account/api/files"| Search
  MCPVision -->|"HTTP, per-turn bearer token<br/>/account/api/files"| Search
  MCPVision -->|"HTTP, X-Internal-API-Key<br/>/search/api/vision-similarity"| Search

  RestAPI -->|"HTTPS, hand-signed SigV4, netguard-checked<br/>per-request creds, never stored"| S3

  Nginx -.->|"stub_status via<br/>prometheus-nginx-exporter"| IONOSMon
  SQLRepo -.->|"postgres-exporter"| IONOSMon
  GPUBox -.->|"vLLM /metrics +<br/>DCGM GPU exporter"| IONOSMon

  GPUControl -.->|"systemctl stop/start"| ChatAPI
  GPUControl -.->|"systemctl stop/start"| ComfyUI
