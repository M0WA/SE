#!/bin/sh
set -e
if ! id searchengine >/dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin searchengine
fi
chown searchengine:searchengine /etc/searchengine/searchengine.env
chmod 640 /etc/searchengine/searchengine.env
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable searchengine.service
fi
echo "searchengine installed. Start with: systemctl start searchengine"
exit 0
