# Env file for searchengine-gpu-control.service -- installed only on
# gpu.mo-sys.de (the private-LAN GPU host), never on the main
# searchengine host. See ../gpu-control/README.md for the full picture.

# Required -- the service refuses to start with this blank. Authenticates
# every request (except /healthz) via a matching X-Internal-Token header,
# same convention as CRAWL_INTERNAL_TOKEN but mandatory here rather than
# optional: this service runs as root and can stop/start systemd units, so
# there is no safe "disabled" fallback the way an empty
# CRAWL_INTERNAL_TOKEN has. Generate with `openssl rand -hex 32` and enter
# the identical value into searchengine's own admin-configured GPU mode
# settings (Chat -> Settings -> GPU mode (Vision) -> Control endpoint
# token) -- the two are the same shared secret, not independently
# generated.
GPU_CONTROL_TOKEN=

# Private-LAN bind address -- never 0.0.0.0. The existing iptables
# ruleset on this host (packaging/firewall/gpu-mo-sys-de.sh) already
# allows the whole private subnet this address lives on, so no firewall
# change is needed for this service specifically; see this directory's
# README for the full reasoning.
GPU_CONTROL_LISTEN_ADDR=10.7.226.11:8002

# How long a single chat<->vision switch may take before it's reported as
# failed. Leave blank/0 to use the built-in default (300s) -- keep this in
# sync with (or below) searchengine's own admin-configured
# switch_timeout_seconds if that's ever changed from its own default.
GPU_CONTROL_SWITCH_TIMEOUT_SECONDS=

# Automatically reverts to chat mode after this many minutes with no
# heartbeat while in Vision mode (0 disables the revert). Leave blank to
# use the built-in default (15).
GPU_CONTROL_IDLE_REVERT_MINUTES=

# Readiness-probe URLs this service polls after starting each side --
# only worth overriding if either service's own listen address ever
# changes from the values already documented in
# docs/architecture/README.md.
GPU_CONTROL_COMFY_READY_URL=http://127.0.0.1:8188/system_stats
GPU_CONTROL_VLLM_READY_URL=http://10.7.226.11:8001/v1/models
