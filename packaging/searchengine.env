DB_DRIVER=sqlite
DB_DSN=file:/var/lib/searchengine/search.db?cache=shared

# ADMIN_USER and ADMIN_PASSWORD gate /crawl and /admin. Until both are set,
# authentication fails closed: sign-in always refuses, so those stay locked.
ADMIN_USER=
ADMIN_PASSWORD=

# Listen addresses for the three independent binaries/services. All three
# default to loopback-only -- nginx (or another reverse proxy on the same
# host) is the only thing meant to reach any of them, including
# search-server, whose results are public but whose plain-HTTP port isn't
# meant to be reachable directly from the internet.
SEARCH_LISTEN_ADDR=127.0.0.1:8080
ADMIN_LISTEN_ADDR=127.0.0.1:8081
CRAWL_LISTEN_ADDR=127.0.0.1:8082

# admin-server's client for talking to crawl-server's internal API.
CRAWL_SERVER_URL=http://127.0.0.1:8082

# Shared secret both admin-server and crawl-server read from this same file
# -- crawl-server checks every RoutesCrawlInternal request against it
# (except /healthz), and admin-server's crawlclient.Client sends it on
# every request. Defense in depth on top of CRAWL_LISTEN_ADDR's default
# loopback-only bind and nginx never proxying that port: this is the one
# check that still holds if either of those is ever misconfigured, e.g. a
# CRAWL_LISTEN_ADDR changed to 0.0.0.0 for container networking. Left
# blank, the check is skipped entirely (matches this codebase's behavior
# before it existed) -- set it (the same value in both places, since it's
# one shared file) to turn it on; e.g. `openssl rand -hex 32`.
CRAWL_INTERNAL_TOKEN=

# Encrypts the admin-configured embedding HTTP API key
# (Settings page -> Embedding -> API key) at rest in the shared
# app_settings table -- read by all three processes (each builds its own
# embedder from this same setting at startup). Left blank, the key is
# stored in plaintext, exactly as before this existed. Set a 32-byte
# hex-encoded key (`openssl rand -hex 32`) -- the same value in this one
# shared file, since all three services read it -- to turn encryption on;
# only DB-only access (a backup, a read replica, an unrelated SQL
# injection) is what this protects against, not access to this file
# itself, which already holds ADMIN_PASSWORD in plaintext.
SETTINGS_ENCRYPTION_KEY=

# Where Playwright (internal/adapters/browserfetcher, used only when a
# crawl's rendering mode is chromium/firefox) caches its downloaded driver
# and browser binaries. Only crawl-server's systemd unit actually needs
# these -- but they're harmless on the other two binaries, which never
# import that package. Playwright's own default is $HOME/.cache/..., which
# searchengine-crawl.service's ProtectHome=true blocks entirely (that
# directive hides /home from the service regardless of ownership/
# permissions); /var/lib/searchengine is the one directory the service's
# ReadWritePaths actually grants write access to.
PLAYWRIGHT_DRIVER_PATH=/var/lib/searchengine/ms-playwright-driver
PLAYWRIGHT_BROWSERS_PATH=/var/lib/searchengine/ms-playwright-browsers
# Playwright's driver (a Node.js process) also needs a writable temp
# directory to stage a browser download into before moving it into
# PLAYWRIGHT_BROWSERS_PATH -- ProtectSystem=strict makes the default /tmp
# read-only for the service too, the same reason PLAYWRIGHT_DRIVER_PATH
# above is needed. postinst creates this directory.
TMPDIR=/var/lib/searchengine/tmp

# Directory search-server's hookrunner adapter resolves every admin-
# configured chat hook's Script filename against (Admin -> Chat -> Hooks) --
# see ports.HookScriptRunner/domain.ChatHook. Only search-server needs this
# (it's the only process that ever runs a hook, as part of answering a real
# chat turn). Scripts here are static, admin-authored config, not runtime
# data any service writes to, so this lives under /etc/searchengine
# alongside this file rather than /var/lib/searchengine -- see
# packaging/chat-hooks/README.md for what installing a script here
# involves; postinst does not create this directory or install anything
# into it, the same deliberately-manual convention as packaging/searxng/'s
# Docker Compose file.
CHAT_HOOKS_DIR=/etc/searchengine/hooks

# Optional pre-shared key letting a trusted local caller (the SearXNG
# engine in packaging/searxng-engine/) call GET /search without a browser
# session, via a matching X-Internal-API-Key header -- see
# requireAuthAPIOrInternalKey in internal/adapters/restapi/auth.go. Empty
# (the default) means the bypass does not exist at all: /search stays
# session-cookie-only, exactly as if this variable didn't exist. Only
# search-server reads this. Generate with e.g. openssl rand -hex 32, and
# set the identical value as searxng-engine's internal_api_key -- see
# packaging/searxng-engine/README.md's Authentication section.
SEARCH_INTERNAL_API_KEY=
