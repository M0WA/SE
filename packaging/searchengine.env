DB_DRIVER=sqlite
DB_DSN=file:/var/lib/searchengine/search.db?cache=shared

# ADMIN_USER and ADMIN_PASSWORD gate /crawl and /admin. Until both are set,
# authentication fails closed: sign-in always refuses, so those stay locked.
ADMIN_USER=
ADMIN_PASSWORD=

# Listen addresses for the three independent binaries/services.
# search-server is the only one meant to be reachable publicly (via nginx);
# admin-server and crawl-server default to loopback-only.
SEARCH_LISTEN_ADDR=:8080
ADMIN_LISTEN_ADDR=127.0.0.1:8081
CRAWL_LISTEN_ADDR=127.0.0.1:8082

# admin-server's client for talking to crawl-server's internal API.
CRAWL_SERVER_URL=http://127.0.0.1:8082
