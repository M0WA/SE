## Deployed to /etc/default/prometheus-nginx-exporter.
## Scrapes nginx's stub_status page (see ../nginx/stub_status.conf),
## which is bound to 127.0.0.1:8090 and only reachable from this host.
## --web.listen-address is loopback-only for the same reason as
## prometheus.default.
ARGS="--web.listen-address=127.0.0.1:9113 --nginx.scrape-uri=http://127.0.0.1:8090/nginx_status"
