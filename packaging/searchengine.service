[Unit]
Description=Custom hybrid search engine (BM25 + semantic)
After=network.target

[Service]
Type=simple
User=searchengine
Group=searchengine
EnvironmentFile=/etc/searchengine/searchengine.env
ExecStart=/usr/bin/searchengine
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/searchengine

[Install]
WantedBy=multi-user.target
